<header class="bg-white shadow-sm h-16 flex items-center justify-between px-4 lg:px-8 sticky top-0 z-10 w-full mb-6">
    <div class="flex items-center gap-4">
        <button onclick="toggleSidebar()" class="lg:hidden text-gray-500 hover:text-primary focus:outline-none">
            <i class="fa-solid fa-bars text-xl"></i>
        </button>
        <div class="text-xl font-bold text-gray-700 lg:hidden">
            <%= typeof title !=='undefined' ? title : 'Dashboard' %>
        </div>
    </div>

    <div class="flex items-center gap-3 ml-auto">
        <div class="text-right hidden sm:block">
            <div class="text-sm font-semibold text-gray-700">
                <%= user.firstName %>
                    <%= user.lastName %>
            </div>
            <div class="text-xs text-gray-500">
                <%= (user.roles && user.roles.length> 0) ? user.roles : 'Admin' %>
            </div>
        </div>
        <img src="https://ui-avatars.com/api/?name=<%= user.firstName %>+<%= user.lastName %>&background=009933&color=fff"
            alt="Admin" class="w-9 h-9 rounded-full object-cover border border-gray-200">
    </div>
</header>