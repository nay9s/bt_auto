<!DOCTYPE html>
<html lang="th">

<%- include('partials/head') %>

    <body class="bg-gray-50 text-gray-800 font-kanit">

        <%- include('partials/sidebar', { path: '/admin/customers' }) %>

            <!-- Main Content -->
            <div class="lg:ml-64 min-h-screen flex flex-col transition-all duration-300">

                <!-- Top Header -->
                <header
                    class="bg-white shadow-sm h-16 flex items-center justify-between px-4 lg:px-8 sticky top-0 z-10">
                    <div class="flex items-center gap-4">
                        <button onclick="toggleSidebar()"
                            class="lg:hidden text-gray-500 hover:text-primary focus:outline-none">
                            <i class="fa-solid fa-bars text-xl"></i>
                        </button>
                        <div class="text-xl font-bold text-gray-700 lg:hidden">ลูกค้า</div>
                    </div>

                    <div class="flex items-center gap-3">
                        <div class="text-right hidden sm:block">
                            <div class="text-sm font-semibold text-gray-700">
                                <%= user.firstName %>
                                    <%= user.lastName %>
                            </div>
                            <div class="text-xs text-gray-500">เจ้าของอู่</div>
                        </div>
                        <img src="https://ui-avatars.com/api/?name=<%= user.firstName %>+<%= user.lastName %>&background=009933&color=fff"
                            alt="Admin" class="w-9 h-9 rounded-full object-cover border border-gray-200">
                    </div>
                </header>

                <!-- Page Content -->
                <main class="flex-1 p-4 lg:p-8">

                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
                        <div>
                            <h2 class="text-2xl font-bold text-gray-800">ลูกค้า</h2>
                            <p class="text-sm text-gray-500">จัดการฐานข้อมูลลูกค้า</p>
                        </div>
                        <button onclick="toggleAddModal()"
                            class="bg-primary hover:bg-primary-dark text-white px-4 py-2 rounded-lg shadow-sm flex items-center justify-center gap-2 transition-colors text-sm font-medium">
                            <i class="fa-solid fa-plus"></i> เพิ่มลูกค้าใหม่
                        </button>
                    </div>

                    <!-- Error Alert -->
                    <div id="errorAlert"
                        class="hidden mb-4 bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative"
                        role="alert">
                        <span class="block sm:inline" id="errorMessage"></span>
                        <span class="absolute top-0 bottom-0 right-0 px-4 py-3"
                            onclick="this.parentElement.style.display='none'">
                            <i class="fa-solid fa-times"></i>
                        </span>
                    </div>

                    <!-- Filters & Search -->
                    <div
                        class="bg-white rounded-t-xl shadow-sm border-b border-gray-100 p-4 flex flex-col sm:flex-row gap-3">
                        <form action="/admin/customers" method="GET" class="relative flex-1">
                            <i
                                class="fa-solid fa-search absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
                            <input type="text" name="search" value="<%= pagination.search %>"
                                placeholder="ค้นหาลูกค้า..."
                                class="w-full pl-10 pr-3 py-2 border border-gray-200 rounded-lg focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary text-sm">
                        </form>
                        <div class="flex gap-2">
                            <!-- Helper button to submit form on helper click if needed, or just let enter key work -->
                            <a href="/admin/customers/export?search=<%= pagination.search %>"
                                class="px-3 py-2 border border-gray-200 rounded-lg text-gray-600 hover:bg-gray-50 text-sm flex items-center gap-2">
                                <i class="fa-solid fa-external-link-alt"></i> <span class="hidden sm:inline">ส่งออก
                                    CSV</span>
                            </a>
                        </div>
                    </div>

                    <!-- Table -->
                    <div class="bg-white rounded-b-xl shadow-sm overflow-hidden">
                        <div class="overflow-x-auto">
                            <table class="w-full min-w-[800px]">
                                <thead class="bg-gray-50 border-b border-gray-200">
                                    <tr>
                                        <th
                                            class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                            ชื่อ-นามสกุล</th>
                                        <th
                                            class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                            อีเมล</th>
                                        <th
                                            class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                            เบอร์โทร</th>
                                        <th
                                            class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">
                                            จำนวนรถ</th>
                                        <th
                                            class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
                                            ยอดใช้จ่ายรวม</th>
                                        <th
                                            class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                            เข้าบริการล่าสุด</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-gray-200">
                                    <% if (customers.length> 0) { %>
                                        <% customers.forEach(customer=> { %>
                                            <tr class="hover:bg-gray-50 transition-colors">
                                                <td
                                                    class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                                                    <%= customer.name %>
                                                </td>
                                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                                    <%= customer.email %>
                                                </td>
                                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                                    <%= customer.phone %>
                                                </td>
                                                <td
                                                    class="px-6 py-4 whitespace-nowrap text-sm text-center text-gray-500">
                                                    <span
                                                        class="inline-flex items-center justify-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                                        <%= customer.carCount %>
                                                    </span>
                                                </td>
                                                <td
                                                    class="px-6 py-4 whitespace-nowrap text-sm text-right text-gray-900 font-medium">
                                                    <%= customer.totalSpent %>
                                                </td>
                                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                                    <%= customer.lastVisit %>
                                                </td>
                                            </tr>
                                            <% }) %>
                                                <% } else { %>
                                                    <tr>
                                                        <td colspan="6" class="px-6 py-10 text-center text-gray-500">
                                                            <i
                                                                class="fa-solid fa-users-slash text-4xl mb-3 text-gray-300 block"></i>
                                                            ไม่พบข้อมูลลูกค้า
                                                        </td>
                                                    </tr>
                                                    <% } %>
                                </tbody>
                            </table>
                        </div>

                        <!-- Pagination -->
                        <div
                            class="px-6 py-4 border-t border-gray-200 flex flex-col sm:flex-row items-center justify-between gap-4">
                            <div class="text-sm text-gray-500">
                                แสดง <span class="font-medium text-gray-900">
                                    <%= (pagination.page - 1) * pagination.limit + 1 %>
                                </span>
                                ถึง <span class="font-medium text-gray-900">
                                    <%= Math.min(pagination.page * pagination.limit, pagination.totalItems) %>
                                </span>
                                จาก <span class="font-medium text-gray-900">
                                    <%= pagination.totalItems %>
                                </span> รายการ
                            </div>

                            <div class="flex items-center gap-1">
                                <% if (pagination.page> 1) { %>
                                    <a href="/admin/customers?page=<%= pagination.page - 1 %>&search=<%= pagination.search %>"
                                        class="w-8 h-8 flex items-center justify-center rounded border border-gray-300 bg-white text-gray-500 hover:bg-gray-50 hover:text-gray-700">
                                        <i class="fa-solid fa-chevron-left text-xs"></i>
                                    </a>
                                    <% } else { %>
                                        <span
                                            class="w-8 h-8 flex items-center justify-center rounded border border-gray-200 bg-gray-50 text-gray-300 cursor-not-allowed">
                                            <i class="fa-solid fa-chevron-left text-xs"></i>
                                        </span>
                                        <% } %>

                                            <% for(let i=1; i <=pagination.totalPages; i++) { %>
                                                <a href="/admin/customers?page=<%= i %>&search=<%= pagination.search %>"
                                                    class="w-8 h-8 flex items-center justify-center rounded border <%= pagination.page === i ? 'border-primary bg-primary text-white' : 'border-gray-300 bg-white text-gray-700 hover:bg-gray-50' %> text-sm font-medium transition-colors">
                                                    <%= i %>
                                                </a>
                                                <% } %>

                                                    <% if (pagination.page < pagination.totalPages) { %>
                                                        <a href="/admin/customers?page=<%= pagination.page + 1 %>&search=<%= pagination.search %>"
                                                            class="w-8 h-8 flex items-center justify-center rounded border border-gray-300 bg-white text-gray-500 hover:bg-gray-50 hover:text-gray-700">
                                                            <i class="fa-solid fa-chevron-right text-xs"></i>
                                                        </a>
                                                        <% } else { %>
                                                            <span
                                                                class="w-8 h-8 flex items-center justify-center rounded border border-gray-200 bg-gray-50 text-gray-300 cursor-not-allowed">
                                                                <i class="fa-solid fa-chevron-right text-xs"></i>
                                                            </span>
                                                            <% } %>
                            </div>
                        </div>
                    </div>

                </main>
            </div>

            <!-- Add Customer Modal -->
            <div id="addCustomerModal"
                class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden flex items-center justify-center p-4">
                <div class="bg-white rounded-xl shadow-lg w-full max-w-md overflow-hidden transform transition-all scale-95 opacity-0"
                    id="modalContent">
                    <div class="bg-gray-50 px-6 py-4 border-b border-gray-100 flex justify-between items-center">
                        <h3 class="text-lg font-bold text-gray-800">เพิ่มลูกค้าใหม่</h3>
                        <button onclick="toggleAddModal()" class="text-gray-400 hover:text-gray-600 focus:outline-none">
                            <i class="fa-solid fa-times text-xl"></i>
                        </button>
                    </div>

                    <form action="/admin/customers/add" method="POST" class="p-6 space-y-4">
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">ชื่อจริง <span
                                        class="text-red-500">*</span></label>
                                <input type="text" name="firstName" required
                                    class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary text-sm">
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">นามสกุล <span
                                        class="text-red-500">*</span></label>
                                <input type="text" name="lastName" required
                                    class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary text-sm">
                            </div>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">เบอร์โทรศัพท์ <span
                                    class="text-red-500">*</span></label>
                            <input type="tel" name="phone" required
                                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary text-sm"
                                placeholder="08xxxxxxxx">
                            <p class="text-xs text-gray-500 mt-1">* ใช้เป็นชื่อผู้ใช้และรหัสผ่านเริ่มต้น</p>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">อีเมล (ถ้ามี)</label>
                            <input type="email" name="email"
                                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary text-sm">
                        </div>

                        <div class="pt-4 flex justify-end gap-3">
                            <button type="button" onclick="toggleAddModal()"
                                class="px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 text-sm font-medium">ยกเลิก</button>
                            <button type="submit"
                                class="px-4 py-2 bg-primary hover:bg-primary-dark text-white rounded-lg text-sm font-medium shadow-sm transition-colors">บันทึกข้อมูล</button>
                        </div>
                    </form>
                </div>
            </div>

            <script>
                function toggleAddModal() {
                    const modal = document.getElementById('addCustomerModal');
                    const content = document.getElementById('modalContent');

                    if (modal.classList.contains('hidden')) {
                        modal.classList.remove('hidden');
                        // Small delay to allow display:block to apply before opacity transition
                        setTimeout(() => {
                            content.classList.remove('scale-95', 'opacity-0');
                            content.classList.add('scale-100', 'opacity-100');
                        }, 10);
                    } else {
                        content.classList.remove('scale-100', 'opacity-100');
                        content.classList.add('scale-95', 'opacity-0');
                        setTimeout(() => {
                            modal.classList.add('hidden');
                        }, 300);
                    }
                }

                // Check for error in URL
                const urlParams = new URLSearchParams(window.location.search);
                const error = urlParams.get('error');
                if (error) {
                    document.getElementById('errorAlert').classList.remove('hidden');
                    document.getElementById('errorMessage').textContent = decodeURIComponent(error);
                    // Clean URL
                    window.history.replaceState({}, document.title, window.location.pathname);
                }
            </script>

    </body>

</html>