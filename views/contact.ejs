<!DOCTYPE html>
<html lang="th">
<%- include('partials/header', { pageTitle: 'ติดต่อเรา' }) %>

    <body>
        <%- include('partials/navbar', { path: '/contact' , user: user }) %>

            <div class="container main-wrapper d-block mt-40 contact-wrapper">
                <div class="section-header mb-30 text-center">
                    <h2><i class="fa-solid fa-headset"></i> ติดต่อเรา</h2>
                    <p>เราพร้อมให้ความช่วยเหลือทุกคำถามและบริการ</p>
                </div>

                <div class="contact-grid">
                    <div class="car-card">
                        <h3><i class="fa-solid fa-location-dot text-danger"></i> ที่ตั้งอู่</h3>
                        <p class="contact-address">
                            123/45 ถนนวิภาวดีรังสิต <br>
                            แขวงจอมพล เขตจตุจักร <br>
                            กรุงเทพมหานคร 10900
                        </p>
                        <div class="map-placeholder">
                            [Google Map Placeholder]
                        </div>
                    </div>

                    <div class="car-card">
                        <h3><i class="fa-solid fa-address-book text-blue"></i> ช่องทางติดต่อ</h3>
                        <ul class="contact-list-ul">
                            <li class="contact-item-li">
                                <div class="contact-icon-wrapper">
                                    <i class="fa-solid fa-phone text-blue"></i>
                                </div>
                                <div>
                                    <div class="font-weight-600">โทรศัพท์</div>
                                    <a href="tel:02-123-4567" class="contact-link">02-123-4567</a>
                                </div>
                            </li>
                            <li class="contact-item-li">
                                <div class="contact-icon-wrapper">
                                    <i class="fa-brands fa-line text-green-line"></i>
                                </div>
                                <div>
                                    <div class="font-weight-600">Line Official</div>
                                    <a href="#" class="contact-link">@btautoservice</a>
                                </div>
                            </li>
                            <li class="contact-item-li">
                                <div class="contact-icon-wrapper">
                                    <i class="fa-solid fa-envelope text-danger"></i>
                                </div>
                                <div>
                                    <div class="font-weight-600">อีเมล</div>
                                    <a href="mailto:contact@btauto.com" class="contact-link">contact@btauto.com</a>
                                </div>
                            </li>
                        </ul>

                        <div class="office-hours-section">
                            <h4 class="mb-10">เวลาทำการ</h4>
                            <p class="text-gray-500 mb-5">จันทร์ - เสาร์: 08:30 - 17:30 น.</p>
                            <p class="text-danger mt-0">อาทิตย์: ปิดทำการ</p>
                        </div>
                    </div>
                </div>
            </div>

            <%- include('partials/footer') %>
    </body>

</html>