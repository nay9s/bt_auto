<!DOCTYPE html>
<html lang="th">
<%- include('partials/header', { pageTitle: 'สถานะการซ่อม' }) %>

    <body>
        <%- include('partials/navbar', { path: '/car-status' , user: user }) %>

            <div class="container main-wrapper d-block mt-40">
                <div class="section-header mb-30">
                    <h2><i class="fa-solid fa-list-check"></i> สถานะการซ่อมปัจจุบัน</h2>
                    <p>ติดตามความคืบหน้างานซ่อมของคุณแบบ Real-time</p>
                </div>

                <% if (typeof orders !=='undefined' && orders.length> 0) { %>
                    <% orders.forEach(order=> {
                        // Determine border color based on status
                        let borderClass = 'border-left-red';
                        let badgeClass = 'status-badge-processing';
                        let badgeText = 'กำลังดำเนินการ';

                        if (order.status === 'completed') {
                        borderClass = 'border-left-green opacity-80';
                        badgeClass = 'status-badge-completed';
                        badgeText = 'เสร็จสิ้น';
                        } else if (order.status === 'ready_for_pickup') {
                        borderClass = 'border-left-green';
                        badgeClass = 'status-badge-completed'; // Or custom
                        badgeText = 'พร้อมส่งมอบ';
                        }

                        // Steps Definition
                        const steps = [
                        { label: 'รับรถแล้ว', icon: 'fa-check' },
                        { label: 'เช็คสภาพ', icon: 'fa-check' }, // or fa-stethoscope
                        { label: 'รออะไหล่', icon: 'fa-check' }, // or fa-box
                        { label: 'กำลังซ่อม', icon: 'fa-wrench' },
                        { label: 'ซ่อมแล้ว', icon: 'fa-car-side' },
                        { label: 'พร้อมส่งมอบ', icon: 'fa-key' }
                        ];
                        %>

                        <div class="car-card <%= borderClass %> mb-40">
                            <div class="car-header flex-column-gap-15">
                                <div class="status-badge <%= badgeClass %> align-self-start">
                                    <%= badgeText %>
                                </div>
                                <div class="car-info mt-0 flex-column-full">
                                    <div class="car-img car-img-full">
                                        <img src="<%= order.image_url || 'https://via.placeholder.com/300?text=No+Image' %>"
                                            alt="<%= order.brand %> <%= order.model %>" class="img-cover">
                                    </div>
                                    <div class="car-details">
                                        <h3>
                                            <%= order.brand %>
                                                <%= order.model %>
                                        </h3>
                                        <div class="plate-num">ทะเบียน <%= order.license_plate %>
                                        </div>
                                        <div class="mt-10">
                                            <span class="text-gray-600 text-sm"><i class="fa-regular fa-clock"></i>
                                                รับรถเมื่อ: <%= order.formattedDate %></span>
                                        </div>
                                        <% if (order.end_date) { %>
                                            <div class="mt-5">
                                                <span class="text-gray-600 text-sm"><i
                                                        class="fa-regular fa-calendar-check"></i>
                                                    เสร็จเมื่อ: <%= order.formattedEndDate %></span>
                                            </div>
                                            <% } %>
                                    </div>
                                </div>
                            </div>

                            <% if (order.status !=='completed' && order.status !=='canceled' ) { %>
                                <div class="status-timeline">
                                    <% steps.forEach((step, index)=> {
                                        // Logic for active state
                                        // order.activeStepIndex comes from server:
                                        // pending=0, checking=1, waiting_parts=2, repairing=3, ready=5, completed=6

                                        let stepClass = '';
                                        let iconClass = '';

                                        if (index <= order.activeStepIndex) { stepClass='active' ; iconClass='active' ;
                                            } if (index===order.activeStepIndex) { stepClass +=' text-danger font-bold'
                                            ; iconClass +=' current' ; } %>
                                            <div class="status-step">
                                                <div class="step-icon <%= iconClass %>">
                                                    <i class="fa-solid <%= step.icon %>"></i>
                                                </div>
                                                <div class="step-text <%= stepClass %>">
                                                    <%= step.label %>
                                                </div>
                                            </div>
                                            <% }); %>
                                </div>
                                <% } %>

                                    <% if (order.description) { %>
                                        <div class="mt-20 pt-15 border-top-gray">
                                            <h4>หมายเหตุจากช่าง:</h4>
                                            <p class="text-gray-600">
                                                <%= order.description %>
                                            </p>
                                        </div>
                                        <% } %>

                                            <% if (order.status==='ready_for_pickup' ) { %>
                                                <div class="ready-banner mb-0">
                                                    <div class="check-circle">
                                                        <i class="fa-solid fa-check"></i>
                                                    </div>
                                                    <div class="ready-text">
                                                        <strong>รถของคุณพร้อมแล้ว!</strong>
                                                        <span>กรุณาติดต่อรับรถภายในเวลาทำการ</span>
                                                    </div>
                                                </div>
                                                <% } %>
                        </div>
                        <% }); %>
                            <% } else { %>
                                <div class="car-card text-center py-5">
                                    <p class="text-gray-500">ไม่พบรายการซ่อมในขณะนี้</p>
                                    <a href="/home" class="btn btn-primary mt-3">กลับหน้าหลัก</a>
                                </div>
                                <% } %>
            </div>

            <%- include('partials/footer') %>
    </body>

</html>