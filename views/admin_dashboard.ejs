<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - BT Auto Service</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        body {
            font-family: 'Prompt', sans-serif;
            background-color: #f8f9fa;
        }

        .sidebar {
            height: 100vh;
            background-color: #2c3e50;
            color: white;
            position: fixed;
            width: 250px;
            padding-top: 20px;
        }

        .sidebar a {
            color: #bdc3c7;
            text-decoration: none;
            display: block;
            padding: 15px 20px;
            transition: 0.3s;
        }

        .sidebar a:hover,
        .sidebar a.active {
            background-color: #1abc9c;
            color: white;
        }

        .main-content {
            margin-left: 250px;
            padding: 20px;
        }

        .stat-card {
            border: none;
            border-radius: 10px;
            color: white;
            padding: 20px;
        }

        .bg-gradient-primary {
            background: linear-gradient(45deg, #1abc9c, #16a085);
        }

        .bg-gradient-warning {
            background: linear-gradient(45deg, #f1c40f, #f39c12);
        }

        .bg-gradient-success {
            background: linear-gradient(45deg, #2ecc71, #27ae60);
        }

        .bg-gradient-danger {
            background: linear-gradient(45deg, #e74c3c, #c0392b);
        }
    </style>
</head>

<body>

    <!-- Sidebar -->
    <div class="sidebar">
        <h4 class="text-center mb-4"><i class="fas fa-tools"></i> BT Auto Admin</h4>
        <a href="/admin/dashboard" class="active"><i class="fas fa-tachometer-alt me-2"></i> Dashboard</a>
        <a href="/admin/repairs"><i class="fas fa-wrench me-2"></i> งานซ่อม (Repairs)</a>
        <a href="/admin/cars"><i class="fas fa-car me-2"></i> รถยนต์ (Cars)</a>
        <a href="/admin/inventory"><i class="fas fa-boxes me-2"></i> คลังสินค้า (Inventory)</a>
        <a href="/logout" class="mt-5"><i class="fas fa-sign-out-alt me-2"></i> ออกจากระบบ</a>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <h2 class="fw-bold mb-4">Dashboard ภาพรวม</h2>

        <div class="row g-4 mb-4">
            <div class="col-md-3">
                <div class="card stat-card bg-gradient-success">
                    <h5>รายได้ทั้งหมด</h5>
                    <h2 class="fw-bold" id="totalIncome">฿0</h2>
                    <small>จากการซ่อมที่เสร็จสิ้น</small>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card stat-card bg-gradient-warning">
                    <h5>งานที่กำลังทำ</h5>
                    <h2 class="fw-bold" id="activeJobs">0</h2>
                    <small>คัน</small>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card stat-card bg-gradient-primary">
                    <h5>รถเดือนนี้</h5>
                    <h2 class="fw-bold" id="carsThisMonth">0</h2>
                    <small>คัน</small>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card stat-card bg-gradient-danger">
                    <h5>รถรออะไหล่</h5>
                    <h2 class="fw-bold" id="waitingParts">0</h2> <!-- Placeholder logic -->
                    <small>คัน</small>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-8">
                <div class="card border-0 shadow-sm p-3">
                    <h5 class="fw-bold mb-3">รายได้ 6 เดือนย้อนหลัง</h5>
                    <canvas id="incomeChart"></canvas>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm p-3">
                    <h5 class="fw-bold mb-3">สถานะงานซ่อม</h5>
                    <canvas id="statusChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Recent Jobs Table -->
        <div class="card border-0 shadow-sm mt-4">
            <div class="card-header bg-white fw-bold py-3">
                <i class="fas fa-history me-2"></i> งานซ่อมล่าสุด
            </div>
            <div class="card-body">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>ทะเบียน</th>
                            <th>ช่างผู้รับผิดชอบ</th>
                            <th>สถานะ</th>
                            <th>จัดการ</th>
                        </tr>
                    </thead>
                    <tbody id="recentJobsTable">
                        <!-- JS will populate -->
                    </tbody>
                </table>
            </div>
        </div>

    </div>

    <script>
        // Fetch Dashboard Data
        fetch('/api/dashboard/stats')
            .then(res => res.json())
            .then(response => {
                if (response.success) {
                    const data = response.data;
                    document.getElementById('totalIncome').innerText = '฿' + data.totalIncome.toLocaleString();
                    document.getElementById('activeJobs').innerText = data.activeJobs;
                    document.getElementById('carsThisMonth').innerText = data.carsThisMonth;

                    // Setup Charts (Basic Implementation)
                    const ctxStatus = document.getElementById('statusChart');
                    const statusLabels = data.statusDistribution.map(d => d.status);
                    const statusCounts = data.statusDistribution.map(d => d.count);

                    new Chart(ctxStatus, {
                        type: 'doughnut',
                        data: {
                            labels: statusLabels,
                            datasets: [{
                                data: statusCounts,
                                backgroundColor: ['#f1c40f', '#2ecc71', '#e74c3c', '#3498db', '#95a5a6']
                            }]
                        }
                    });
                }
            });

        // Dummy Income Chart
        new Chart(document.getElementById('incomeChart'), {
            type: 'bar',
            data: {
                labels: ['Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov'],
                datasets: [{
                    label: 'รายได้ (บาท)',
                    data: [12000, 19000, 3000, 5000, 20000, 30000],
                    backgroundColor: '#1abc9c'
                }]
            }
        });
    </script>
</body>

</html>